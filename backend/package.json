{
  "name": "@guardtab/backend",
  "version": "0.1.0",
  "private": true,
  "description": "GuardTab backend API — Fastify + TypeScript + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "openapi": "tsx --env-file=.env scripts/generate-openapi.ts",
    "backfill:scores": "tsx --env-file=.env scripts/backfill-scores.ts",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/passport": "^4.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@guardtab/shared": "*",
    "@prisma/client": "^5.20.0",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.3.8",
    "fastify": "^5.12.4",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.20.0",
    "psl": "^1.9.0",
    "undici": "^6.19.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/psl": "^1.1.3",
    "@vitest/coverage-v8": "^5.0.1",
    "autocannon": "^8.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^10.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
