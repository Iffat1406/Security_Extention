# GuardTab — environment variable template
# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Variables are grouped by the build phase that introduces them (see
# GuardTab-Technical-Requirements-v3.docx, section 32 "Revised Build Roadmap").
# Only the "Phase 1" group is required to run the backend today.

# ---- Phase 1 — Backend foundation -----------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Matches docker-compose.yml's postgres service.
DATABASE_URL="postgresql://guardtab:guardtab_dev_password@localhost:5433/guardtab?schema=public"

# Comma-separated list of origins allowed to call the API (dashboard, extension).
CORS_ORIGIN=http://localhost:3000

# ---- Phase 2 — Authentication & RBAC ---------------------------------------
JWT_SECRET=                # 32+ random chars — e.g. `openssl rand -hex 32`. Rotate if compromised.
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=              # 32+ random chars, separate from JWT_SECRET — signs the refresh cookie.
AUDIT_IP_HASH_SALT=         # 16+ random chars — server-side salt for audit_logs.ip_hash (§28.4).

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Authorized redirect URI must match GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---- Phase 2 onwards — Redis (dedup cache, rate limits, job queue) --------
# REDIS_URL=redis://localhost:6379

# ---- Phase 5 — Backend reputation checks -----------------------------------
# SAFE_BROWSING_API_KEY=
# VIRUSTOTAL_API_KEY=

# ---- Phase 7 — AI explanation layer ----------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MONTHLY_SPEND_CAP_USD=25

# ---- Phase 9 — Advanced detection ------------------------------------------
# WHOIS_API_KEY=
